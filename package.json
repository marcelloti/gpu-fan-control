{
  "name": "gpu-fan-control",
  "description": "Control and monitor your GPU Fans",
  "version": "0.3.0",
  "private": false,
  "author": "Marcello Costa <contato@insiderti.com.br>",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcelloti/gpu-fan-control.git"
  },
  "keywords": ["gpu", "fan control", "gpu temperature", "gpu fan control", "linux gpu tools"],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "OPEN_DEVTOOLS=1 electron-vite dev",
    "build": "electron-vite build",
    "electron:build": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "chart.js": "^4.4.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "vue": "^3.4.21"
  },
  "build": {
    "appId": "com.insiderti.gpu-fan-control",
    "productName": "GPU Fan Control",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "resources/logo.png"
    },
    "extraResources": [
      { "from": "resources/logo.png", "to": "logo.png" }
    ]
  }
}
